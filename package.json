{
  "name": "supa-store",
  "version": "0.1.0",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/RoJaebl/supa-store.git" },
  "packageManager": "pnpm@11.18.0",
  "type": "module",
  "bin": { "store-gen": "./tools/cli.mjs" },
  "files": ["dist", "plugin", "tools/*.cjs", "tools/*.mjs", "tools/*.d.mts", "!tools/*.test.mjs"],
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./react": { "types": "./dist/react.d.ts", "import": "./dist/react.js" },
    "./query": { "types": "./dist/query.d.ts", "import": "./dist/query.js" },
    "./config": { "types": "./dist/config.d.ts", "import": "./dist/config.js" },
    "./vite": { "types": "./tools/vite.d.mts", "default": "./tools/vite.mjs" },
    "./next": { "types": "./tools/next.d.mts", "default": "./tools/next.mjs" },
    "./plugin": "./tools/plugin.cjs"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "pnpm build && vitest run && node --test \"tools/!(pack).test.mjs\"",
    "test:pack": "node --test tools/pack.test.mjs",
    "prepublishOnly": "pnpm test && pnpm test:pack",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json"
  },
  "peerDependencies": { "next": ">=14", "react": ">=18", "typescript": ">=5.4", "vite": ">=6" },
  "peerDependenciesMeta": { "next": { "optional": true }, "react": { "optional": true }, "vite": { "optional": true } },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "jsdom": "^30.1.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.8.0",
    "vite": "^8.3.5",
    "vitest": "^3.1.0"
  }
}
